# Unreal folders that should never be in git
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# IDE junk
.idea/
.vs/
.vscode/

# Content assets (keep them out of git/LFS entirely)
Content/

# These project files can be regenerated
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# User-specific files
*.DotSettings.user
